@using Syncfusion.EJ2.Navigations
@{
    List<Object> menuItems = new List<object>();

    menuItems.Add(new
    {
        text = "Dashboard",
        url = "/",
        iconCss = "fa fa-solid fa-chart-pie"
    });

    menuItems.Add(new
    {
        text = "Transactions",
        url = "/Transaction",
        iconCss = "fa fa-solid fa-arrow-right-arrow-left"
    });

    menuItems.Add(new
    {
        text = "Categories",
        url = "/Category",
        iconCss = "fa fa-solid fa-folder-closed"
    });
}

<ejs-sidebar id="sidebar" width="290px" enableDock dockSize="100px" target=".dock-target" enableGestures=true>
    <e-content-template>
        <div class="logo-wrapper">
            <div class="app-logo">
                <img class="app-logo-image" src="~/logo.png" alt="" />
                <span class="app-brand">Expense</span>
            </div>
            <div class="w-100"></div>
            <i id="sidebar-toggler" class="fa-solid"></i>
        </div>

        <ejs-menu id="menu"
                  items="@menuItems"
                  orientation="Vertical"
                  hamburgerMode></ejs-menu>
    </e-content-template>
</ejs-sidebar>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var dockBar = document.getElementById('sidebar').ej2_instances[0];
        var compactLayout = null;

        function updateSidebarForViewport() {
            var useCompactLayout = window.matchMedia('(max-width: 767.98px)').matches;
            if (useCompactLayout === compactLayout) {
                return;
            }

            compactLayout = useCompactLayout;
            dockBar.setProperties({ dockSize: useCompactLayout ? '72px' : '100px' });
            var shouldBeOpen = !useCompactLayout;
            if (dockBar.isOpen !== shouldBeOpen) {
                dockBar.toggle();
            }
        }

        updateSidebarForViewport();
        window.addEventListener('resize', updateSidebarForViewport);

        document.getElementById('sidebar-toggler').onclick = function () {
            dockBar.toggle();
        };
    });
</script>