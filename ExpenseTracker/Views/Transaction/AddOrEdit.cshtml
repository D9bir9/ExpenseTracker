@model ExpenseTracker.Models.Transaction
@{
    ViewData["PageTitle"] = Model.TransactionId == 0 ? "Create a new Transaction" : "Edit transaction";

    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var currentCurrency = "USD"; 
    var format = "c0"; 

    try 
    {
        var region = new System.Globalization.RegionInfo(currentCulture);
        currentCurrency = region.ISOCurrencySymbol;
        
        
        if (currentCurrency == "NGN")
        {
            
            format = "'₦'#,0"; 
        }
        else if (currentCurrency == "JPY")
        {
            format = "'¥'#,0";
        }
    } 
    catch { }
}

<div class="row">
    <div class="col-md-7">
        <div class="widget p-5">
            <form asp-action="AddOrEdit">
                <input asp-for="TransactionId" hidden />
                <input asp-for="CultureCode" hidden />
                <div asp-validation-summary="ModelOnly"></div>
                <div class="mb-3">
                    <ejs-dropdownlist id="ddlCategory" dataSource="@ViewBag.Categories" ejs-for="CategoryId" 
                    placeholder="Category" floatLabelType="Always" allowFiltering=true
                    ignoreAccent=true filterType="Contains" popupHeight="220px">
                        <e-dropdownlist-fields text="TitleWithIcon" value="CategoryId"></e-dropdownlist-fields>  
                    </ejs-dropdownlist>
                    <span asp-validation-for="CategoryId" class="text-danger fs-6"></span>
                </div>
                
                <div class="mb-3">
                    <ejs-numerictextbox id="amount" placeholder="Amount" ejs-for="Amount" floatLabelType="Always" min=0 format="@format", locale="@currentCulture" currency="@currentCurrency"></ejs-numerictextbox>
                    <span asp-validation-for="Amount" class="text-danger fs-6"></span>
                </div>
                <div class="mb-3">
                    <ejs-textbox id="icon" placeholder="Note" ejs-for="Note" floatLabelType="Always" multiline=true></ejs-textbox>
                </div>
                <div class="mb-3">
                    <ejs-datepicker id="date" placeholder="Date" ejs-for="Date" floatLabelType="Always"
                    format="MMM-dd-yy"></ejs-datepicker>
                </div>

                 <ejs-button id="submit" type="submit" cssClass="e-success" content="@(Model.TransactionId == 0? "Create" : "Update")"></ejs-button>
            </form>
        </div>
    </div>
    <div class="col-md-5">
        <div class="widget h-100 d-flex justify-content-center align-items-center">
            <i class="fa-solid fa-money-bill-transfer fa-2xl"></i>
        </div>
    </div>
</div>