@using ExpenseTracker.Helpers
@using System.Globalization
@{
    ViewData["IsDashboard"] = true;

    var currencyIcon = CurrencyDisplayHelper.GetIconClass();
    
    // Define the data source for your Syncfusion DropDownList
    var dateOptions = new[] {
        new { Id = "7days", Text = "Last 7 Days" },
        new { Id = "14days", Text = "Last 14 Days" },
        new { Id = "30days", Text = "Last 30 Days" },
        new { Id = "thismonth", Text = "This Month" }
    };

    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var cultures = new[]
    {
        new { Value = "en-US", Text = "USD - $" },
        new { Value = "en-GB", Text = "GBP - £" },
        new { Value = "en-NG", Text = "NGN - ₦" }
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h3 class="fw-bold m-0">Dashboard</h3>
    </div>

    <div class="d-flex flex-row align-items-center gap-3">
        <a href="/Budget" class="btn btn-sm btn-outline-light">Budget Targets</a>

        <div style="width: 220px;">
            <form id="cultureForm" asp-controller="Culture" asp-action="SetCulture" method="post"
                asp-route-returnUrl="@Context.Request.Path">
                <ejs-dropdownlist id="cultureDropdown"
                                name="culture"
                                dataSource="@cultures"
                                value="@currentCulture"
                                change="onCultureChange">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
            </form>
        </div>

        <div style="width: 220px;">
            <ejs-dropdownlist id="dateRangePicker" 
                            dataSource="@dateOptions" 
                            index="0"
                            change="onDateRangeChange">
                <e-dropdownlist-fields text="Text" value="Id"></e-dropdownlist-fields>
            </ejs-dropdownlist>
        </div>
    </div>


</div>

<div class="row mb-4">
    <!-- Income Card -->
    <div class="col-md-4">
        <div class="d-flex flex-row widget summary income">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid @currencyIcon fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Total Income</span>
                <h1 id="totalIncome" class="display-6 fw-bold">0</h1> 
            </div>
        </div>
    </div>

    <!-- Expense Card -->
    <div class="col-md-4">
        <div class="d-flex flex-row widget summary expense">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid @currencyIcon fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Total Expense</span>
                <h1 id="totalExpense" class="display-6 fw-bold">0</h1>
            </div>
        </div>
    </div>

    <!-- Balance Card -->
    <div class="col-md-4">
        <div class="d-flex flex-row widget summary balance">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid @currencyIcon fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Balance</span>
                <h1 id="balance" class="display-6 fw-bold">0</h1>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="d-flex flex-row widget summary budget-limit">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid @currencyIcon fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Monthly Budget</span>
                <h1 id="totalBudget" class="display-6 fw-bold">0</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="d-flex flex-row widget summary budget-spent">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid fa-wallet fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Spent Against Targets</span>
                <h1 id="budgetSpent" class="display-6 fw-bold">0</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="d-flex flex-row widget summary budget-remaining">
            <div class="d-flex flex-column justify-content-center p-5">
                <i class="fa-solid fa-piggy-bank fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3">
                <span class="lead">Remaining</span>
                <h1 id="budgetRemaining" class="display-6 fw-bold">0</h1>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="widget p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Budget status</h5>
                <span id="budgetWarnings" class="badge bg-warning text-dark">0 warnings</span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Remaining</span>
                    <span id="budgetRemainingText">0</span>
                </div>
                <div class="progress" style="height: 12px;">
                    <div id="budgetRemainingBar" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                </div>
            </div>

            <div id="budgetStatusList"></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="widget chart h-100">
            <div class="title p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0">Monthly spend</h5>
                    <span id="budgetMonthComparison" class="small text-muted"></span>
                </div>
                <ejs-chart id="month-comparison-chart" height="280px" palettes="@(new string[]{"#cb9b00", "#0e8d76"})">
                    <e-chart-primaryxaxis valueType="Category">
                        <e-majorgridlines width="0"></e-majorgridlines>
                        <e-majorticklines width="0"></e-majorticklines>
                    </e-chart-primaryxaxis>
                    <e-chart-primaryyaxis labelFormat="c0">
                        <e-majorgridlines width="1" color="#cbd5e1" dashArray="3,5"></e-majorgridlines>
                        <e-majorticklines width="0"></e-majorticklines>
                    </e-chart-primaryyaxis>
                    <e-chart-chartarea>
                        <e-chartarea-border width="0"></e-chartarea-border>
                    </e-chart-chartarea>
                    <e-series-collection>
                        <e-series xName="period" yName="amount" name="Spending" width="0.6"
                                  type="@Syncfusion.EJ2.Charts.ChartSeriesType.Column"></e-series>
                    </e-series-collection>
                    <e-chart-tooltipsettings enable></e-chart-tooltipsettings>
                </ejs-chart>
            </div>
        </div>
    </div>
</div>

@* doughnut chart and spline chart *@
<div class="row mb-4">
    <div class="col-4">
        <div class="widget chart">
            <div class="title p-4">
                <h5 class="fw-bold">Expense By Category</h5>
                <ejs-accumulationchart id="doughnutchart" enableAnimation enableSmartLabels>
                    <e-accumulation-series-collection>
                        <e-accumulation-series xName="categoryTitleWithIcon"
                        yName="amount" innerRadius="60%" legendShape="Circle"
                        palettes=@(new string[]{"#0e8d76","#a4b219","#cb9b00","#8a442c","#0454b5","#7d0a0a","#822690","#4c2090","#313e93","#0096ac"})>
                            <e-accumulationseries-datalabel name="formattedAmount" visible=true></e-accumulationseries-datalabel>
                        </e-accumulation-series>
                    </e-accumulation-series-collection>
                    <e-accumulationchart-legendsettings position="Top" toggleVisibility=false>
                        <e-legendsettings-textstyle color="#475569" size="1rem"></e-legendsettings-textstyle>
                    </e-accumulationchart-legendsettings>
                    <e-accumulationchart-tooltipsettings enable></e-accumulationchart-tooltipsettings>
                </ejs-accumulationchart>
            </div>
        </div>
    </div>
    <div class="col-8">
        <div class="widget chart">
            <div class="title p-4">
                <h5 class="fw-bold">Income vs Expense</h5>
                <ejs-chart id="spline-chart" palettes="@(new string[]{"#54ffa9", "#ffe91a"})">
                    <e-chart-primaryxaxis valueType="Category">
                        <e-majorgridlines width="0"></e-majorgridlines>
                        <e-majorticklines width="0"></e-majorticklines>
                    </e-chart-primaryxaxis>
                    <e-chart-primaryyaxis>
                        <e-majorgridlines width="1" color="#cbd5e1" dashArray="3,5"></e-majorgridlines>
                        <e-majorticklines width="0"></e-majorticklines>
                        <e-linestyle width="0"></e-linestyle>
                    </e-chart-primaryyaxis>
                    <e-chart-chartarea >
                        <e-chartarea-border width="0"></e-chartarea-border>
                    </e-chart-chartarea>
                    <e-series-collection>
                        <e-series xName="day" yName="income" name="Income" width="3"
                        type="@Syncfusion.EJ2.Charts.ChartSeriesType.Spline"></e-series>
                        <e-series xName="day" yName="expense" name="Expense" width="3"
                        type="@Syncfusion.EJ2.Charts.ChartSeriesType.Spline"></e-series>
                    </e-series-collection>
                    <e-chart-legendsettings position="Top" alignment="Far" toggleVisibility=false>
                        <e-legendsettings-textstyle color="#475569" size="1rem"></e-legendsettings-textstyle>
                    </e-chart-legendsettings>
                    <e-chart-tooltipsettings enable shared></e-chart-tooltipsettings>
                </ejs-chart>
            </div>
        </div>
    </div>
</div>

@* Recent Transactions *@
<div class="row">
    <div class="col-md-6">
        <div class="widget">
            <h5 class="fw-bold">Recent Transactions</h5>
            <div class="px-4 pb-4">
                <ejs-grid id="recent-transaction" gridLines="None">
                    <e-grid-columns>
                        <e-grid-column field="CategoryTitleWithIcon" headerText="Category"></e-grid-column>
                        <e-grid-column field="Date" headerText="Date" width="110px" type="date" format="MMM-dd-yy"
                        textAlign="Left"></e-grid-column>
                        <e-grid-column field="FormattedAmount" headerText="Amount" width="110px" textAlign="Right"></e-grid-column>
                        <e-grid-column field="Note" headerText="Note" width="110px"></e-grid-column>
                    </e-grid-columns>
                </ejs-grid>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="widget chart h-100">
            <div class="title p-4">
                <h5 class="fw-bold">Monthly budget vs spending</h5>
                <div id="budgetChartEmpty" class="text-muted py-5 text-center" hidden>
                    Set category targets to compare your monthly spending.
                </div>
                <div id="budgetChartContainer">
                    <ejs-chart id="budget-chart" palettes="@(new string[]{"#0e8d76", "#cb9b00"})">
                        <e-chart-primaryxaxis valueType="Category">
                            <e-majorgridlines width="0"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                        </e-chart-primaryxaxis>
                        <e-chart-primaryyaxis labelFormat="c0">
                            <e-majorgridlines width="1" color="#cbd5e1" dashArray="3,5"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                        </e-chart-primaryyaxis>
                        <e-chart-chartarea>
                            <e-chartarea-border width="0"></e-chartarea-border>
                        </e-chart-chartarea>
                        <e-series-collection>
                            <e-series xName="categoryTitle" yName="spent" name="Spent" width="2"
                                      type="@Syncfusion.EJ2.Charts.ChartSeriesType.Column"></e-series>
                            <e-series xName="categoryTitle" yName="limit" name="Target" width="2"
                                      type="@Syncfusion.EJ2.Charts.ChartSeriesType.Column"></e-series>
                        </e-series-collection>
                        <e-chart-legendsettings position="Top" alignment="Far" toggleVisibility=false>
                            <e-legendsettings-textstyle color="#475569" size="1rem"></e-legendsettings-textstyle>
                        </e-chart-legendsettings>
                        <e-chart-tooltipsettings enable shared></e-chart-tooltipsettings>
                    </ejs-chart>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Runs automatically when the user selects a different range in the dropdown
    function onDateRangeChange(args) {
        updateDashboard(args.value);
    }

    // Fetches fresh metrics via an AJAX call and updates card contents instantly
    function updateDashboard(range) {
        var url = '@Url.Action("GetDashboardData", "Dashboard")' + '?dateRange=' + range;

        fetch(url)
            .then(response => response.json())
            .then(data => {
                document.getElementById("totalIncome").innerText = data.totalIncome;
                document.getElementById("totalExpense").innerText = data.totalExpense;
                document.getElementById("balance").innerText = data.balance;
                document.getElementById("totalBudget").innerText = data.budgetSummary.totalBudget;
                document.getElementById("budgetSpent").innerText = data.budgetSummary.totalBudgetSpent;
                document.getElementById("budgetRemaining").innerText = data.budgetSummary.totalBudgetRemaining;

                var remainingPercent = Math.min(Math.max(data.budgetSummary.totalBudgetRemainingPercent || 0, 0), 100);
                var remainingBar = document.getElementById('budgetRemainingBar');
                var remainingText = document.getElementById('budgetRemainingText');
                if (remainingBar) {
                    remainingBar.style.width = remainingPercent + '%';
                    remainingBar.className = 'progress-bar ' + (data.budgetSummary.totalBudgetRemaining < 0 ? 'bg-danger' : data.budgetSummary.totalBudgetRemaining > 0 ? 'bg-success' : 'bg-warning text-dark');
                }
                if (remainingText) {
                    remainingText.innerText = data.budgetSummary.totalBudgetRemaining;
                }

                var monthComparison = document.getElementById('budgetMonthComparison');
                if (monthComparison) {
                    var change = data.budgetSummary.monthOverMonthChangeAmount;
                    monthComparison.innerText = data.budgetSummary.monthOverMonthChangePercent == null
                        ? (change > 0 ? 'New' : 'No change')
                        : (change > 0 ? 'Up ' : change < 0 ? 'Down ' : 'No change')
                            + (change !== 0 ? Math.abs(data.budgetSummary.monthOverMonthChangePercent).toFixed(1) + '%' : '');
                    monthComparison.className = 'fw-semibold ' + (change > 0 ? 'text-danger' : 'text-success');
                }

                var monthComparisonChart = document.getElementById('month-comparison-chart').ej2_instances[0];
                if (monthComparisonChart) {
                    monthComparisonChart.dataSource = [
                        { period: 'Last', amount: data.budgetSummary.lastMonthExpenseAmount },
                        { period: 'This', amount: data.budgetSummary.thisMonthExpenseAmount }
                    ];
                    monthComparisonChart.refresh();
                }

                document.getElementById("budgetWarnings").innerText = data.budgetSummary.warningCount + ' warnings';
                document.getElementById("budgetWarnings").className = data.budgetSummary.warningCount > 0 ? 'badge bg-warning text-dark' : 'badge bg-success';

                var budgetList = document.getElementById('budgetStatusList');
                if (budgetList) {
                    budgetList.replaceChildren();
                    (data.budgetData || []).forEach(function (item) {
                        var progress = Math.min(Math.max(item.progressPercent || 0, 0), 100);
                        var status = !item.hasLimit ? 'No target set' : item.overBudget ? 'Over budget' : item.nearLimit ? 'Near limit' : 'On track';
                        var statusClass = !item.hasLimit ? 'text-muted' : item.overBudget ? 'text-danger' : item.nearLimit ? 'budget-near-limit' : 'text-success';
                        var progressClass = !item.hasLimit ? 'bg-secondary' : item.overBudget ? 'bg-danger' : item.nearLimit ? 'bg-warning' : 'bg-success';

                        var row = document.createElement('div');
                        row.className = 'mb-3';
                        var heading = document.createElement('div');
                        heading.className = 'd-flex justify-content-between align-items-center mb-1';
                        var title = document.createElement('span');
                        title.className = 'fw-semibold';
                        title.textContent = item.categoryTitle;
                        var amount = document.createElement('span');
                        amount.className = statusClass;
                        amount.textContent = item.hasLimit
                            ? item.spentText + ' / ' + item.limitText
                            : item.spentText + ' spent';
                        heading.append(title, amount);

                        var progressTrack = document.createElement('div');
                        progressTrack.className = 'progress';
                        progressTrack.style.height = '10px';
                        progressTrack.setAttribute('aria-label', status + ' for ' + item.categoryTitle);
                        var progressBar = document.createElement('div');
                        progressBar.className = 'progress-bar ' + progressClass;
                        progressBar.setAttribute('role', 'progressbar');
                        progressBar.setAttribute('aria-valuenow', progress);
                        progressBar.setAttribute('aria-valuemin', '0');
                        progressBar.setAttribute('aria-valuemax', '100');
                        progressBar.style.width = progress + '%';
                        progressTrack.append(progressBar);

                        var details = document.createElement('div');
                        details.className = 'd-flex justify-content-between mt-1 small ' + statusClass;
                        var statusLabel = document.createElement('span');
                        statusLabel.className = 'badge ' + (item.overBudget ? 'bg-danger' : item.nearLimit ? 'bg-warning text-dark' : item.hasLimit ? 'bg-success' : 'bg-secondary');
                        statusLabel.textContent = status;
                        var remaining = document.createElement('span');
                        remaining.textContent = item.hasLimit ? Math.round(item.progressPercent) + '% used · ' + item.remainingText + ' left' : 'No target set';
                        details.append(statusLabel, remaining);
                        row.append(heading, progressTrack, details);
                        budgetList.append(row);
                    });

                    if (!data.budgetData || data.budgetData.length === 0) {
                        var emptyState = document.createElement('div');
                        emptyState.className = 'text-muted';
                        emptyState.textContent = 'No expense categories with budgets set yet.';
                        budgetList.append(emptyState);
                    }
                }

                // Dougnut Chart
                var chartInstance = document.getElementById('doughnutchart').ej2_instances[0];
                
                if (chartInstance) {
                    chartInstance.series[0].dataSource = data.chartData;
                    
                    chartInstance.refresh();
                }

                // Spline Chart
                var splineChartInstance = document.getElementById('spline-chart').ej2_instances[0];
                
                if (splineChartInstance) {
                    splineChartInstance.dataSource = data.splineData;

                    splineChartInstance.refresh();
                }

                var budgetChart = document.getElementById('budget-chart').ej2_instances[0];
                var budgetChartContainer = document.getElementById('budgetChartContainer');
                var budgetChartEmpty = document.getElementById('budgetChartEmpty');
                var budgetTargets = (data.budgetData || []).filter(function (item) {
                    return item.hasLimit;
                });

                if (budgetChart) {
                    if (budgetTargets.length > 0) {
                        budgetChartContainer.hidden = false;
                        budgetChartEmpty.hidden = true;
                        budgetChart.series[0].dataSource = budgetTargets;
                        budgetChart.series[1].dataSource = budgetTargets;
                        budgetChart.refresh();
                    } else {
                        budgetChartContainer.hidden = true;
                        budgetChartEmpty.hidden = false;
                    }
                }

                // Recent Transactions
                var gridInstance = document.getElementById('recent-transaction').ej2_instances[0];

                if (gridInstance) {
                    gridInstance.dataSource = data.recentTransactionData;

                    gridInstance.refresh();
                }
            })
            .catch(error => console.error("Error loading dashboard data:", error));
    }

    // Triggers an initial load for "Last 7 Days" as soon as the DOM is ready
    document.addEventListener("DOMContentLoaded", function () {
        updateDashboard("7days");
    });

    // This function automatically submits the form when a new culture is clicked
    function onCultureChange(args) {
        // args.value contains the newly selected culture string (e.g., "en-NG")
        if (args.value) {
            document.getElementById('cultureForm').submit();
        }
    }
</script>
