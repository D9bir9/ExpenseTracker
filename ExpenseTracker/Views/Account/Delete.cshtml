@model ExpenseTracker.Models.Account.DeleteAccountViewModel
@{
    ViewData["IsDashboard"] = true;
    ViewData["Title"] = "Delete account";
}

<div class="auth-page">
    <div class="widget auth-card account-delete-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="account-delete-icon mb-3">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h1 class="h3 fw-bold mb-1">Delete your account?</h1>
            <p class="text-muted mb-0">This permanently removes your account and all its financial data.</p>
        </div>

        <div class="alert alert-warning">
            <strong>@Model.Email</strong> and all categories, budgets, and transactions owned by this account will be deleted. This cannot be undone.
        </div>

        <form asp-action="Delete" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Confirm your password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Confirmation" class="form-label">Type DELETE to continue</label>
                <input asp-for="Confirmation" class="form-control" autocomplete="off" />
                <span asp-validation-for="Confirmation" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-danger w-100">Permanently delete account</button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-controller="Dashboard" asp-action="Index">Cancel and return to dashboard</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
